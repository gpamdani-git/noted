# Noted Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit real secrets or production credentials to git

# Google OAuth 2.0 Web Client ID (Free - from Google Cloud Console)
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# PostgreSQL Database Connection (Optional for Vercel / Cloud Sync)
# Works with Vercel Postgres, Neon, Supabase, Railway, Render, or local Postgres:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
POSTGRES_URL=
DATABASE_URL=

