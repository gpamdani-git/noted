# Noted Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit real secrets or production credentials to git

# Google OAuth 2.0 Web Client ID (Free - from Google Cloud Console)
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID is used by the browser (Google Identity Services button).
VITE_GOOGLE_CLIENT_ID=

# Server-side copy of the same OAuth client id.
# The server verifies Google credentials against this id before issuing a
# session token, so it must match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# PostgreSQL Database Connection (Optional for Vercel / Cloud Sync)
# Works with Vercel Postgres, Neon, Supabase, Railway, Render, or local Postgres:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# This value is NEVER bundled into the client - it is only read on the server
# (Vercel environment variables) or by the Electron main process at runtime.
POSTGRES_URL=
DATABASE_URL=

# Secret used to sign the session tokens that authorize /api/sync calls.
# Generate with: openssl rand -hex 32
# Minimum 16 characters. Rotating it invalidates all existing sessions.
SESSION_SECRET=

# Origins allowed to call the API (comma separated). Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Public URL of the deployed Noted server.
# Required by the desktop app (browser sign-in hand-off) and the Android build.
VITE_APP_URL=

# Server session signature secret (256-bit hex, e.g. generated via crypto.randomBytes(32).toString('hex'))
SESSION_SECRET=

# Resend Transactional Email API Key (Free at https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Noted <onboarding@resend.dev>"

# Extra hosts the Electron main process may reach through the AI bridge.
# Comma separated hostnames. Local LLM endpoints are always allowed.
AI_ALLOWED_HOSTS=

# Additional folders the Vite dev server may read local media from.
# Comma separated absolute paths (e.g. /Users/you/Pictures).
NOTED_MEDIA_ROOTS=
