{
  "name": "noted",
  "private": true,
  "version": "1.0.0",
  "description": "Noted - Modern Notion-grade Workspace with Dual Local & Cloud Sync",
  "author": "Dani Akbar",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:preview": "vite build && cross-env TEST_DIST=1 electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac dmg zip",
    "electron:build:mac:arm64": "vite build && electron-builder --mac dmg zip --arm64",
    "electron:build:mac:x64": "vite build && electron-builder --mac dmg zip --x64",
    "electron:build:mac:both": "vite build && electron-builder --mac dmg zip --arm64 --x64",
    "electron:build:mac:universal": "vite build && electron-builder --mac dmg zip --universal",
    "electron:build:win": "vite build && electron-builder --win nsis portable",
    "electron:build:all": "vite build && electron-builder -mw",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "icons:generate": "node scripts/generate-icons.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:sqlite:push": "drizzle-kit push --config=drizzle.sqlite.config.js",
    "db:sqlite:studio": "drizzle-kit studio --config=drizzle.sqlite.config.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
