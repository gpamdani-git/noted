{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.gpamdani.noted",
  "productName": "Noted",
  "copyright": "Copyright © 2026 Dani Akbar",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "protocols": [
    {
      "name": "Noted Desktop Protocol",
      "schemes": ["noted"]
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64", "universal"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64", "universal"]
      }
    ],
    "category": "public.app-category.productivity",
    "icon": "build/icon.icns",
    "darkModeSupport": true,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Noted Installer",
    "icon": "build/icon.icns",
    "iconSize": 120,
    "contents": [
      {
        "x": 140,
        "y": 220,
        "type": "file"
      },
      {
        "x": 420,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 560,
      "height": 380
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Noted",
    "uninstallDisplayName": "Noted Uninstaller"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Office",
    "icon": "build/icon.png"
  }
}
